<Project Sdk="Microsoft.NET.Sdk">

  <!-- Rhino-free core of the plugin: DTOs, JSON, HTTP client, units, ids, results.
       netstandard2.0 loads in both Rhino 8 runtimes (.NET Framework 4.8 and .NET 7+). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>SkyFrame.Exchange</RootNamespace>
    <AssemblyName>SkyFrame.Exchange</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SkyFrame.Exchange.Tests" />
  </ItemGroup>

</Project>
