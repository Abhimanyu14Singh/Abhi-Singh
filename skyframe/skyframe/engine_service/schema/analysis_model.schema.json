{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyframe.local/schema/analysis_model/0.1.0",
  "title": "SkyFrame analysis model (object level), draft 0.1.0",
  "description": "What a host app sends once the engine meshes and loads the model itself (step 4 of the plan; the solve route for it is not open yet). The app describes objects as the engineer drew them; the engine builds the mesh, elements, constraints and loads. Every object id is stable across edits and every result comes back under it. Units are declared once and apply to every number. Code-based loads (wind and seismic story forces, spectra, combinations) are computed by the host for its chosen code and sent here; the engine adds only what needs the analysis (RS scaling to ELF, the modal period, drift and stability checks).",
  "type": "object",
  "required": ["schema", "units", "stories", "materials", "objects", "loadPatterns", "cases"],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 200, "description": "Stable object id, owned by the host."},
    "xyz": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "poly": {"type": "array", "items": {"$ref": "#/$defs/xyz"}, "minItems": 3},
    "releases6": {"type": "array", "description": "P, V2, V3, T, M2, M3 released (true) at one end.",
                  "items": {"type": "boolean"}, "minItems": 6, "maxItems": 6},
    "frameModifiers": {"type": "object", "additionalProperties": false,
      "properties": {"A": {"type": "number"}, "As2": {"type": "number"}, "As3": {"type": "number"}, "J": {"type": "number"},
                     "I22": {"type": "number"}, "I33": {"type": "number"}, "mass": {"type": "number"}, "weight": {"type": "number"}}},
    "shellModifiers": {"type": "object", "additionalProperties": false,
      "properties": {"f11": {"type": "number"}, "f22": {"type": "number"}, "f12": {"type": "number"},
                     "m11": {"type": "number"}, "m22": {"type": "number"}, "m12": {"type": "number"},
                     "v13": {"type": "number"}, "v23": {"type": "number"}, "mass": {"type": "number"}, "weight": {"type": "number"}}},
    "role": {"enum": ["column", "beam", "girder", "brace", "link", "chord", "web", "edge", "transfer", "other"]}
  },
  "properties": {
    "schema": {"const": "skyframe.analysis_model/0.1"},
    "units": {"type": "object", "required": ["force", "length"],
              "properties": {"force": {"enum": ["N", "kN", "lb", "kip"]}, "length": {"enum": ["mm", "m", "in", "ft"]}}},
    "project": {"type": "object", "properties": {
      "code": {"type": "string", "description": "The host's code basis label, e.g. 'ASCE 7-22'. Informational: code loads arrive computed."},
      "mergeTolerance": {"type": "number", "description": "Nodes closer than this are one node. Default 0.05 ft (15 mm)."},
      "pDelta": {"type": "object", "properties": {"on": {"type": "boolean"}, "loads": {"type": "object", "additionalProperties": {"type": "number"},
                 "description": "Pattern -> factor for the P-Delta gravity load, e.g. {D: 1.2, L: 0.5}."}}}}},
    "stories": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "elevation"],
      "properties": {"name": {"type": "string"}, "elevation": {"type": "number"}, "base": {"type": "boolean"}}}},
    "materials": {"type": "array", "items": {"type": "object", "required": ["id", "type", "E", "nu"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["concrete", "steel", "other"]},
                     "E": {"type": "number", "exclusiveMinimum": 0}, "nu": {"type": "number"},
                     "unitWeight": {"type": "number", "minimum": 0}, "unitMass": {"type": "number", "minimum": 0},
                     "fc": {"type": "number"}, "fy": {"type": "number"}}}},
    "frameSections": {"type": "array", "items": {"type": "object", "required": ["id", "material"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "material": {"$ref": "#/$defs/id"},
                     "catalogue": {"type": "string", "description": "e.g. 'W14X90' (AISC); one of catalogue or shape."},
                     "shape": {"enum": ["rectangle", "circle", "box", "pipe", "I", "T", "L", "C"]},
                     "dims": {"type": "object", "additionalProperties": {"type": "number"},
                              "description": "rectangle {b, h}; circle {d}; box {b, h, tf, tw}; pipe {d, t}; I {d, bf, tf, tw} ..."},
                     "modifiers": {"$ref": "#/$defs/frameModifiers"}}}},
    "areaSections": {"type": "array", "items": {"type": "object", "required": ["id", "material", "thickness", "kind"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "material": {"$ref": "#/$defs/id"},
                     "thickness": {"type": "number", "exclusiveMinimum": 0},
                     "kind": {"enum": ["wall", "slab", "deck"]},
                     "behaviour": {"enum": ["membrane", "shell"], "description": "Default: wall shell; slab/deck membrane."},
                     "span": {"enum": ["one-way", "two-way"]},
                     "deck": {"type": "object", "properties": {"ribDepth": {"type": "number"}, "ribSpacing": {"type": "number"}, "toppingThickness": {"type": "number"}}},
                     "modifiers": {"$ref": "#/$defs/shellModifiers"}}}},
    "modifierSets": {"type": "object", "description": "Named stiffness sets by role; default 'strength' = ACI 318-19 6.6.3.1.1, 'service' = strength x 1.4.",
      "additionalProperties": {"type": "object", "additionalProperties": {"type": "number"}}},
    "objects": {"type": "object", "properties": {
      "frames": {"type": "array", "items": {"type": "object", "required": ["id", "i", "j", "section", "role"],
        "properties": {"id": {"$ref": "#/$defs/id"}, "i": {"$ref": "#/$defs/xyz"}, "j": {"$ref": "#/$defs/xyz"},
                       "section": {"$ref": "#/$defs/id"}, "role": {"$ref": "#/$defs/role"},
                       "angle": {"type": "number", "description": "Local axis rotation, degrees."},
                       "cardinal": {"type": "integer", "minimum": 1, "maximum": 11},
                       "releaseI": {"$ref": "#/$defs/releases6"}, "releaseJ": {"$ref": "#/$defs/releases6"},
                       "rigidZoneFactor": {"type": "number", "minimum": 0, "maximum": 1},
                       "modifiers": {"$ref": "#/$defs/frameModifiers"}, "system": {"type": "string"}}}},
      "areas": {"type": "array", "items": {"type": "object", "required": ["id", "boundary", "section"],
        "properties": {"id": {"$ref": "#/$defs/id"}, "boundary": {"$ref": "#/$defs/poly"},
                       "openings": {"type": "array", "items": {"$ref": "#/$defs/poly"}},
                       "section": {"$ref": "#/$defs/id"}, "pier": {"type": "string"}, "spandrel": {"type": "string"},
                       "modifiers": {"$ref": "#/$defs/shellModifiers"}, "system": {"type": "string"}}}},
      "supports": {"type": "array", "items": {"type": "object", "required": ["at", "restraint"],
        "properties": {"at": {"$ref": "#/$defs/xyz"}, "restraint": {"type": "array", "items": {"type": "boolean"}, "minItems": 6, "maxItems": 6},
                       "springs": {"type": "array", "items": {"type": "number"}, "minItems": 6, "maxItems": 6}}}},
      "baseFixed": {"type": "boolean", "description": "Every node at the base story fully fixed. Default true."}}},
    "diaphragms": {"type": "array", "items": {"type": "object", "required": ["id", "story", "kind"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "story": {"type": "string"}, "kind": {"enum": ["rigid", "semi-rigid"]},
                     "areas": {"type": "array", "items": {"$ref": "#/$defs/id"}, "description": "Floor areas in it; default all floor areas on that story."}}}},
    "loadPatterns": {"type": "array", "items": {"type": "object", "required": ["id", "type"],
      "properties": {"id": {"$ref": "#/$defs/id"},
                     "type": {"enum": ["dead", "superdead", "live", "reducible-live", "roof-live", "snow", "wind", "seismic", "notional", "other"]},
                     "selfWeight": {"type": "number", "default": 0}}}},
    "loads": {"type": "object", "properties": {
      "area": {"type": "array", "items": {"type": "object", "required": ["pattern", "area", "value"],
        "properties": {"pattern": {"$ref": "#/$defs/id"}, "area": {"$ref": "#/$defs/id"}, "value": {"type": "number", "description": "force/length2, gravity direction positive"}}}},
      "frame": {"type": "array", "items": {"type": "object", "required": ["pattern", "frame", "w"],
        "properties": {"pattern": {"$ref": "#/$defs/id"}, "frame": {"$ref": "#/$defs/id"}, "w": {"$ref": "#/$defs/xyz"},
                       "axes": {"enum": ["global", "local"]}}}},
      "point": {"type": "array", "items": {"type": "object", "required": ["pattern", "at", "f"],
        "properties": {"pattern": {"$ref": "#/$defs/id"}, "at": {"$ref": "#/$defs/xyz"}, "f": {"$ref": "#/$defs/xyz"}}}},
      "storyForces": {"type": "array", "description": "Code wind/seismic story forces computed by the host, applied at the diaphragm centre of mass (or 'at').",
        "items": {"type": "object", "required": ["pattern", "diaphragm", "fx", "fy"],
          "properties": {"pattern": {"$ref": "#/$defs/id"}, "diaphragm": {"$ref": "#/$defs/id"}, "fx": {"type": "number"}, "fy": {"type": "number"},
                         "mz": {"type": "number"}, "at": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}}}}}},
    "massSource": {"type": "object", "properties": {"selfMass": {"type": "boolean", "default": true},
      "patterns": {"type": "object", "additionalProperties": {"type": "number"}}}},
    "spectra": {"type": "array", "items": {"type": "object", "required": ["id", "points"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "points": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
                     "description": "[period s, Sa in g]"}}}},
    "cases": {"type": "array", "items": {"type": "object", "required": ["id", "type"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["linear-static", "modal", "response-spectrum"]},
                     "loads": {"type": "object", "additionalProperties": {"type": "number"}},
                     "modifierSet": {"type": "string", "description": "'strength' or 'service' (default strength)."},
                     "modes": {"type": "integer"}, "targetMass": {"type": "number"},
                     "spectrum": {"$ref": "#/$defs/id"}, "direction": {"enum": ["X", "Y"]}, "scale": {"type": "number"},
                     "scaleToELF": {"type": "object", "properties": {"baseShear": {"type": "number"}}}}}},
    "combos": {"type": "array", "items": {"type": "object", "required": ["id", "type", "terms"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["add", "envelope", "srss", "abs"]},
                     "terms": {"type": "object", "additionalProperties": {"type": "number"}}}}}
  }
}
